<!DOCTYPE struts PUBLIC
    "-//Apache Software Foundation//DTD Struts Configuration 7.5//EN"
    "https://struts.apache.org/dtds/struts-7.5.dtd">
<struts>
    <package name="base" abstract="true" extension="html"/>

    <package name="child" extends="base" namespace="/child">
        <action name="inherits" class="org.apache.struts2.TestAction"/>
        <action name="own" class="org.apache.struts2.TestAction" extension="json,"/>
    </package>

    <package name="plain" namespace="/plain">
        <action name="undeclared" class="org.apache.struts2.TestAction"/>
        <action name="none" class="org.apache.struts2.TestAction" extension=""/>
    </package>

    <package name="wild" namespace="/wild">
        <action name="edit_*" class="org.apache.struts2.TestAction" extension="html"/>
    </package>
</struts>
